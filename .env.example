NODE_ENV=production
PRODUCT_STAGE=controlled-beta
BASE_URL=https://agentrisklayer.com
SESSION_SECRET=replace-with-at-least-32-random-characters
METRICS_TOKEN=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://user:password@host:5432/agentrisklayer
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORISED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DEMO_MODE=false
ALLOW_DEMO_IN_PRODUCTION=false
REQUIRE_BETA_INVITE=true
BETA_INVITE_LIMIT=20
ADMIN_EMAIL=owner@agentrisklayer.com
SUPPORT_EMAIL=support@agentrisklayer.com
COMPANY_LEGAL_NAME=REPLACE WITH LEGAL ENTITY
COMPANY_ADDRESS=REPLACE WITH REGISTERED OR TRADING ADDRESS
LEGAL_JURISDICTION=England and Wales
STRIPE_SECRET_KEY=sk_live_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_PRICE_PRO_REPORT=price_replace
STRIPE_PRICE_DEVELOPER_MONTHLY=price_replace
STRIPE_PRICE_TEAM_MONTHLY=price_replace
STRIPE_PRICE_AGENCY_MONTHLY=price_replace
RESEND_API_KEY=re_replace
EMAIL_FROM=AgentRiskLayer <security@agentrisklayer.com>
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
EMAIL_VERIFICATION_HOURS=24
TRUSTED_PROXY_HOPS=1
FULFILMENT_WORKER_INTERVAL_MS=15000
RETENTION_WORKER_INTERVAL_MS=3600000
BACKUP_RETENTION_DAYS=30
