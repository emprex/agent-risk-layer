# Core application
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
PRODUCT_STAGE=controlled-beta
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true
ALLOW_DEMO_IN_PRODUCTION=false
DATABASE_PATH=./data/agent-risk-layer.sqlite

# Session, identity and workers
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
EMAIL_VERIFICATION_HOURS=24
TRUSTED_PROXY_HOPS=1
FULFILMENT_WORKER_INTERVAL_MS=15000
RETENTION_WORKER_INTERVAL_MS=3600000
BACKUP_RETENTION_DAYS=30

# Product and legal operator
COMPANY_NAME=AgentRiskLayer
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
LEGAL_JURISDICTION=England and Wales
SUPPORT_EMAIL=
ADMIN_EMAIL=
TERMS_VERSION=2026-07-22

# Stripe — required when DEMO_MODE=false
STRIPE_SECRET_KEY=
STRIPE_API_VERSION=2026-06-24.dahlia
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_REPORT=
STRIPE_PRICE_PRO_REPORT=
STRIPE_PRICE_DEVELOPER_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=

# Resend — required for production transactional email
RESEND_API_KEY=
EMAIL_FROM=AgentRiskLayer <reports@example.com>
